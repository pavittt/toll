# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: webhook ID from your sandbox app, enables signature-verified webhooks
PAYPAL_WEBHOOK_ID=
# Sandbox personal account email that receives merchant payouts in the demo
PAYOUT_RECEIVER_EMAIL=

# Anthropic API key for the agent, the rule compiler and the payment judge
ANTHROPIC_API_KEY=
# Optional model overrides
TOLL_MODEL=claude-opus-5-5
TOLL_JUDGE_MODEL=claude-opus-5-5

# Secret used to sign payment tokens. Change it.
TOLL_SECRET=change-me-to-a-long-random-string
GATEWAY_URL=http://localhost:4000
